# ─────────────────────────────────────────────────────────────────────────────
# Backend Lambda environment variable reference.
# These are injected by the CDK ApiStack — do NOT hardcode or commit values.
# This file documents expected env vars for local SAM testing only.
# ─────────────────────────────────────────────────────────────────────────────

# Core AWS
AWS_REGION=us-east-1

# DynamoDB — from CDK output KsmAp-<env>-Database > TableName
DYNAMODB_TABLE_NAME=REPLACE_AFTER_CDK_DEPLOY
DYNAMODB_GSI1_NAME=GSI1

# Messaging
DEMO_MODE=true
SES_FROM_ADDRESS=noreply-dev@example.com
SNS_SMS_SENDER_ID=KSMAutoPilot

# Bedrock — from CDK output KsmAp-<env>-Ai > GuardrailId
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
BEDROCK_GUARDRAIL_ID=REPLACE_AFTER_CDK_DEPLOY
BEDROCK_GUARDRAIL_VERSION=DRAFT

# CORS — from CDK output KsmAp-<env>-Foundation > DistributionDomain
ALLOWED_ORIGIN=https://REPLACE_AFTER_CDK_DEPLOY.cloudfront.net

# Lambda Powertools
POWERTOOLS_SERVICE_NAME=ksmap-dev
LOG_LEVEL=DEBUG

# Local dev only — disables JWT signature verification for SAM local testing
SKIP_AUTH_VERIFY=true
