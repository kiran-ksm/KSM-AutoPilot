# ─────────────────────────────────────────────────────────────────────────────
# KSM AutoPilot — Frontend Environment Variables
# Copy this file to .env.local (dev) or use CI/CD secrets for staging/prod.
# NEVER commit real values to source control.
# ─────────────────────────────────────────────────────────────────────────────

# AWS Region
VITE_AWS_REGION=us-east-1

# Cognito — values come from CDK output KsmAp-<env>-Foundation
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# API Gateway base URL — from CDK output KsmAp-<env>-Api > ApiUrl (no trailing slash)
VITE_API_BASE_URL=https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com/dev

# Set to "true" to enable Demo Mode (SMS/email mocked, Demo Console visible)
VITE_DEMO_MODE=false

# Environment label shown in sidebar footer
VITE_APP_ENV=dev
